# Digital Workshop - Git Ignore

# Build directories
build/
build-*/
cmake-build-*/
out/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Compiled objects
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
__pycache__/
*.pyc

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Package managers
vcpkg_installed/
_deps/

# Packaging artifacts
_CPack_Packages/

# Node
node_modules/

# Testing artifacts
artifacts/
Testing/
CTestTestfile.cmake

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Debug files
*.dSYM/
*.pdb

# Generated files
src/version.h
imgui.ini
package.json

# User-specific
*.user
*.suo

# Database (can be freely deleted - no migrations)
*.db
*.sqlite
*.sqlite3

# Configuration (can be freely deleted)
/config.json
/settings.json

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Claude/Ralph directories
.claude/
.superpowers/
CLAUDE.md
!.ralph/

# Planning artifacts
# Keep milestone-level plans visible to version control; phase scratch/history stays local
# unless it is already tracked explicitly.
.planning/*
!.planning/PROJECT.md
!.planning/MILESTONES.md
!.planning/CAM-INTEGRATION-DESIGN.md
!.planning/plans/
!.planning/plans/**
!.planning/PROJECT-CENTERED-WORKSHOP-PLAN.md
!.planning/PROJECT-CENTERED-WORKSHOP-SESSIONS.md
!.planning/PROJECT-CENTERED-WORKSHOP-BASELINE.md
!.planning/PROJECT-CENTERED-WORKSHOP-USABILITY.md
!.planning/PROJECT-CENTERED-WORKSHOP-RELEASE-VALIDATION.md
!.planning/project-centered-workshop-baseline/
!.planning/project-centered-workshop-baseline/**
!.planning/project-centered-workshop-release/
!.planning/project-centered-workshop-release/**
# Live participant evidence may contain consent records and must stay local.
.planning/project-centered-workshop-release/human-study-live/
.session-summary.md
CHECKPOINT.md
PHASE_01_SUMMARY.md
PHASE_01_VERIFICATION.md

# Clangd index cache
.cache/

# Rulebook
rulebook/

# Documentation
docs/

# Tools
tools/

# Python
__pycache__/
*.pyc
