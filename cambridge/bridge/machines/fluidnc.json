{
  "id": "fluidnc",
  "name": "FluidNC",
  "description": "FluidNC — ESP32 GRBL-compatible controller (successor to Grbl_Esp32)",
  "vendor": "FluidNC",
  "builtin": false,
  "fileExtension": "nc",
  "coordinateSystem": {
    "xAxis": "X",
    "yAxis": "Y",
    "zAxis": "Z"
  },
  "numberFormat": {
    "decimalPlaces": {
      "mm": 3,
      "inch": 4
    },
    "trailingZeros": true,
    "leadingZero": true
  },
  "units": {
    "mmCommand": "G21",
    "inchCommand": "G20"
  },
  "program": {
    "header": [
      "; {programName}",
      "; Generated by PureCutCNC on {date}",
      "G90",
      "G17",
      "{unitsCommand}",
      "{wcsCommand}"
    ],
    "operationHeader": [
      "; Operation {operationIndex}: {operationName}",
      "; Description: {operationDescription}",
      "; Tool {toolNumber}: {toolName}"
    ],
    "footer": [],
    "commentPrefix": ";",
    "commentSuffix": "",
    "lineNumbers": false,
    "lineNumberIncrement": 10
  },
  "workCoordinates": {
    "selectCommand": "G54"
  },
  "motion": {
    "rapidCommand": "G0",
    "linearCommand": "G1",
    "cwArcCommand": "G2",
    "ccwArcCommand": "G3",
    "arcFormat": "ij",
    "modalMotion": true,
    "arcInterpolation": true
  },
  "feedSpeed": {
    "feedCommand": "F",
    "rpmCommand": "S",
    "spindleOnCW": "M3",
    "spindleOnCCW": "M4",
    "spindleOff": "M5",
    "inlineWithMotion": true,
    "modalFeedSpeed": true
  },
  "toolChange": {
    "commands": ["M5", "M0 ; Tool change: {toolName}"],
    "stopSpindleFirst": true,
    "pauseAfterChange": true,
    "pauseCommand": "M0"
  },
  "cannedCycles": null,
  "coolant": {
    "floodOnCommand": "M8",
    "mistOnCommand": "M7",
    "coolantOffCommand": "M9"
  },
  "stop": {
    "programEndCommand": "M30"
  }
}
